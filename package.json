{
  "name": "jj-trafikskola-chatbot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:links": "RUN_LINK_TESTS=1 vitest run tests/links.test.ts",
    "validate:knowledge": "node scripts/validate-knowledge.mjs",
    "check:bundle": "node scripts/check-client-bundle.mjs",
    "test:live": "RUN_LIVE_TESTS=1 node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run tests/live.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "next": "^16.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
